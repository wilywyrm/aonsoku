lines:
  - text: '今日は天気がいい'
    start_ms: 1000
    end_ms: 5000
    transliteration:
      hira: 'きょうはてんきがいい'
      romaji: 'kyō wa tenki ga ii'
    words:
      - text: '今日'
        start_ms: 1000
        end_ms: 2000
        transliteration:
          hira: 'きょう'
          romaji: 'kyō'
      - text: 'は'
        start_ms: 2000
        end_ms: 2500
        transliteration:
          romaji: 'wa'
      - text: '天気'
        start_ms: 2500
        end_ms: 3500
        transliteration:
          hira: 'てんき'
          romaji: 'tenki'
      - text: 'が'
        start_ms: 3500
        end_ms: 4000
        transliteration:
          romaji: 'ga'
      - text: 'いい'
        start_ms: 4000
        end_ms: 5000
        transliteration:
          romaji: 'ii'
  - text: '食べるコーヒーはOK'
    start_ms: 5500
    end_ms: 9000
